# Portfolio/demo configuration. Never commit real secrets.
STREAMLIT_UI_PORT=8722
AGENT_SERVICE_PORT_HOST=8015
AGENT_SERVICE_PORT=8015
SERVICE_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8722

# Model provider: ollama | openai | vllm | gemini
MODEL_TYPE=OpenAI
MODEL_ID=
OPENAI_MODEL_ID=portfolio-free
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=
OLLAMA_MODEL_ID=
OLLAMA_HOST=http://host.docker.internal:11434
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_CHAT_MODEL_ID=
VLLM_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_ID=

# Embeddings
QDRANT_CLOUD_INFERENCE=true
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=legacylens
QDRANT_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_SPARSE_MODEL=qdrant/bm25
QDRANT_DENSE_DIMENSIONS=384

# Database
DATABASE_URL=
DB_USER=ai
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_code_conversion

# Auth / external services
SECRET_KEY=change-me-in-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_VALIDATE_CACHE_TTL_SEC=15
AUTH_SERVICE_BASE_URL=
ANALYZER_API_URL= # Optional external analyzer; leave blank to use local static analysis
AGENT_SERVICE_BASE_URL=http://localhost:8015
GITLAB_SELF_HOSTED_BASE_URL=
PLANTUML_URL=http://localhost:8080
LOG_LEVEL=INFO
CTAGS_BIN=ctags # Optional; Docker installs Universal Ctags and PATH discovery is automatic

# LLM Gateway (LiteLLM)
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# LiteLLM upstream model IDs
OPENROUTER_LITELLM_MODEL=openrouter/free
GEMINI_LITELLM_MODEL=gemini/gemini-flash-lite-latest

# Deterministic local stack detection
STACK_ANALYZER_ENABLED=true
STACK_ANALYZER_VERSION=1.27.6
